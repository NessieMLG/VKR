<mujoco>
  <option gravity="0 0 -9.81" timestep="0.0005"/> <!-- Шаг 0.5 мс для идеальной сходимости жестких связей -->
  
  <worldbody>
    <light diffuse=".8 .8 .8" pos="0 0 3" dir="0 -1 0"/>
    <geom type="plane" size="10 10 0.1" rgba="0.9 0.9 0.9 1"/>

    <!-- Свободный 2D Шар -->
    <body name="ball" pos="0.1 0.1175 0.2">
      <freejoint name="ball_freejoint"/>
      <geom type="sphere" size="0.02" rgba="0.9 0.1 0.1 1" friction="0.5 0.005 0.0001" mass="0.05"/>
    </body>

    <!-- Поворотная платформа (Центр кардана D в точке [0.1, 0.1175, 0.1235]) -->
    <body name="platform_parent" pos="0.1 0.1175 0.1">
      <body name="platform" pos="0 0 0.0235">
        <joint name="platform_joint" type="ball" damping="0.2"/>
        <geom type="box" size="0.15 0.15 0.005" rgba="0.8 0.8 0.8 1" friction="0.5 0.005 0.0001"/>
        
        <!-- Жестко закрепленные ножки Hkp = 0.0235 согласно вашему чертежу -->
        <!-- Ножка 1 (Сдвиг влево по Х на Lkp = -0.12) -->
        <body name="hkp_link1" pos="-0.12 0 0">
          <geom type="capsule" fromto="0 0 0  0 0 -0.0235" size="0.004" rgba="0.4 0.4 0.4 1"/>
          <site name="anchor_platform_mech1" pos="0 0 -0.0235" size="0.005" rgba="1 0 0 1"/>
        </body>
        
        <!-- Ножка 2 (Сдвиг назад по Y на Lkp = -0.12) -->
        <body name="hkp_link2" pos="0 -0.12 0">
          <geom type="capsule" fromto="0 0 0  0 0 -0.0235" size="0.004" rgba="0.4 0.4 0.4 1"/>
          <site name="anchor_platform_mech2" pos="0 0 -0.0235" size="0.005" rgba="0 0 1 1"/>
        </body>
      </body>
    </body>

    <!-- =================================================================== -->
    <!-- МЕХАНИЗМ 1 (Плоскость X-Z, ось вращения мотора Y)                  -->
    <!-- =================================================================== -->
    <body name="mech1_base" pos="0.0 0.1175 -0.041">
      <joint name="mech1_motor" type="hinge" axis="0 1 0" range="-180 180" damping="5.0"/>
      
      <!-- Звено L1: Сдвиг в точку А под углом 164.53566° (влево -X и вверх +Z от мотора) -->
      <body name="link1" pos="-0.03855 0 0.01066">
        <geom type="capsule" fromto="0 0 0  0.03855 0 -0.01066" size="0.005" rgba="0.6 0.6 0.6 1"/>
        
        <!-- Шатун L2 = 0.118: Идет строго вертикально вверх к ножке платформы -->
        <body name="link2" pos="0 0 0">
          <joint name="link2_joint" type="hinge" axis="0 1 0"/>
          <geom type="capsule" fromto="0 0 0  0 0 0.118" size="0.005" rgba="0.7 0.7 0.7 1"/>
          <site name="anchor_mech1_tip" pos="0 0 0.118" size="0.004" rgba="1 0 0 1"/>
        </body>
      </body>
    </body>

    <!-- =================================================================== -->
    <!-- МЕХАНИЗМ 2 (Плоскость Y-Z, ось вращения мотора X)                  -->
    <!-- =================================================================== -->
    <body name="mech2_base" pos="0.1 0.0175 -0.041">
      <joint name="mech2_motor" type="hinge" axis="1 0 0" range="-180 180" damping="5.0"/>
      
      <!-- Звено L1: Сдвиг под тем же углом, но в плоскости Y-Z (влево -Y и вверх +Z от мотора) -->
      <body name="link1_2" pos="0 -0.03855 0.01066">
        <geom type="capsule" fromto="0 0 0  0 0.03855 -0.01066" size="0.005" rgba="0.6 0.6 0.6 1"/>
        
        <!-- Шатун L2 = 0.118: Идет строго вертикально вверх к ножке 2 -->
        <body name="link2_2" pos="0 0 0">
          <joint name="link2_joint_2" type="hinge" axis="1 0 0"/>
          <geom type="capsule" fromto="0 0 0  0 0 0.118" size="0.005" rgba="0.7 0.7 0.7 1"/>
          <site name="anchor_mech2_tip" pos="0 0 0.118" size="0.004" rgba="0 0 1 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="pitch_motor" joint="mech1_motor" gear="10" kp="40"/>
    <position name="roll_motor" joint="mech2_motor" gear="10" kp="40"/>
  </actuator>

  <equality>
    <!-- Затягиваем петли: сопряжение абсолютно жесткое, паразитные колебания исключены -->
    <connect site1="anchor_mech1_tip" site2="anchor_platform_mech1" solref="0.005 1" solimp="0.92 0.98 0.001"/>
    <connect site1="anchor_mech2_tip" site2="anchor_platform_mech2" solref="0.005 1" solimp="0.92 0.98 0.001"/>
  </equality>
</mujoco>
